CONSCIOUSNESS_DB=./backend/data/consciousness.db
CONSCIOUSNESS_LOOP_INTERVAL_SECONDS=60
CONSCIOUSNESS_EXECUTION_MODE=preview
CONSCIOUSNESS_ARTIFACT_ROOT=./backend/data/artifacts

# Local-process provider settings. Preview mode does not require credentials or
# a running model. Compose deliberately uses COMPOSE_OLLAMA_URL instead so this
# localhost value cannot accidentally point a container back at itself.
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434

# Optional local-process only-memories integration. Compose deliberately uses
# COMPOSE_ONLY_MEMORIES_URL; see .env.compose.example.
ONLY_MEMORIES_URL=http://localhost:8765
ONLY_MEMORIES_WRITE_RECAPS=false

# API authentication and the Studio's server-side development proxy. The token
# is injected upstream by Vite/Nginx and is never compiled into the browser bundle.
CONSCIOUSNESS_API_TOKEN=
CONSCIOUSNESS_API_UPSTREAM=http://localhost:8770
CONSCIOUSNESS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

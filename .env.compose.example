# Container runtime settings. Pass this file explicitly with
# `docker compose --env-file .env.compose.example ...`, or copy it to a private
# `.env.compose` file. The host services must use Docker Desktop's host gateway,
# not localhost from inside the containers.
CONSCIOUSNESS_EXECUTION_MODE=preview
CONSCIOUSNESS_LOOP_INTERVAL_SECONDS=60
COMPOSE_OLLAMA_URL=http://host.docker.internal:11434
COMPOSE_ONLY_MEMORIES_URL=http://host.docker.internal:8765
ONLY_MEMORIES_WRITE_RECAPS=false
OPENAI_API_KEY=
CONSCIOUSNESS_API_TOKEN=

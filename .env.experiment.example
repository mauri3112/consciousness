# Copy to .env.experiment for a named, restartable local experiment.
CONSCIOUSNESS_EXECUTION_MODE=live
CONSCIOUSNESS_LOOP_INTERVAL_SECONDS=300
COMPOSE_OLLAMA_URL=http://host.docker.internal:11434
COMPOSE_ONLY_MEMORIES_URL=http://host.docker.internal:8765
ONLY_MEMORIES_WRITE_RECAPS=false
CONSCIOUSNESS_API_TOKEN=
MINIMAX_API_KEY=
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CONSCIOUSNESS_CREDENTIAL_KEY=

EXPERIMENT_ID=memory-stewardship-v2
EXPERIMENT_DURATION_SECONDS=28800
EXPERIMENT_BACKUP_INTERVAL_SECONDS=1800
EXPERIMENT_SNAPSHOT_INTERVAL_SECONDS=900
EXPERIMENT_POLL_SECONDS=15
EXPERIMENT_REQUIRED_LOCAL_MODEL=hf.co/deepreinforce-ai/Ornith-1.0-9B-GGUF:Q4_K_M
EXPERIMENT_AUDIT_MODEL_ID=minimax/MiniMax-M3
EXPERIMENT_MEMORY_SPACE_ID=experiment:memory-stewardship-v2
